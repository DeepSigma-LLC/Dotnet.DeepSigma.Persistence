<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Microsoft SQL Server persistence backend for DeepSigma.Persistence.</Description>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>DeepSigma.Persistence.SqlServer</Title>
    <Version>1.3.0</Version>
    <Authors>DeepSigma LLC</Authors>
    <Copyright />
    <PackageProjectUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.Persistence</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.Persistence</RepositoryUrl>
	<PackageIcon>DeepSigma.png</PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeepSigma.Persistence.Abstractions\DeepSigma.Persistence.Abstraction.csproj" />
    <ProjectReference Include="..\DeepSigma.Persistence.Core\DeepSigma.Persistence.Core.csproj" />
    <PackageReference Include="DeepSigma.DataAccess.SqlServer" />
  </ItemGroup>
</Project>
