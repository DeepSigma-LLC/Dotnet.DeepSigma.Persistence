<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Core types — envelope, serializer, and key utilities for DeepSigma.Persistence.</Description>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>DeepSigma.Persistence.Core</Title>
    <Version>1.3.0</Version>
    <Authors>DeepSigma LLC</Authors>
    <PackageProjectUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.Persistence</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.Persistence.git</RepositoryUrl>
    <PackageIcon>DeepSigma.png</PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>


	  <ItemGroup>
    <ProjectReference Include="..\DeepSigma.Persistence.Abstractions\DeepSigma.Persistence.Abstraction.csproj" />
  </ItemGroup>


	  <ItemGroup>
	    <None Update="Assets\DeepSigma.png">
	      <Pack>True</Pack>
	      <PackagePath>\</PackagePath>
	    </None>
	  </ItemGroup>
</Project>
