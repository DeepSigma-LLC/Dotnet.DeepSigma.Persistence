<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Backends (Dapper / Microsoft.Data.Sqlite / Npgsql / Microsoft.Data.SqlClient come transitively from these) -->
    <PackageVersion Include="DeepSigma.DataAccess.Postgres" Version="1.2.0" />
    <PackageVersion Include="DeepSigma.DataAccess.RelationalDatabase" Version="1.2.0" />
    <PackageVersion Include="DeepSigma.DataAccess.Sqlite" Version="1.2.0" />
    <PackageVersion Include="DeepSigma.DataAccess.SqlServer" Version="1.2.0" />
    <!-- Utilities -->
    <PackageVersion Include="AsyncKeyedLock" Version="6.4.1" />
    <!-- Patched transitive dependencies -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.23" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.3" />
  </ItemGroup>
</Project>